{
  "expo": {
    "name": "MyCloset",
    "slug": "mycloset",
    "version": "1.0.0",
    "scheme": "mycloset",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mycloset.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow MyCloset to access your photos so you can add clothing items.",
        "NSCameraUsageDescription": "Allow MyCloset to use your camera to photograph your clothing."
      }
    },
    "android": {
      "package": "com.mycloset.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MyCloset to access your photos so you can add clothing items.",
          "cameraPermission": "Allow MyCloset to use your camera to photograph your clothing.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "root": "src/app",
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f5958362-ada4-492f-9ce3-be8500bac82b"
      }
    },
    "owner": "markobz",
    "runtimeVersion": "exposdk:58.0.0",
    "updates": {
      "url": "https://u.expo.dev/f5958362-ada4-492f-9ce3-be8500bac82b"
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
